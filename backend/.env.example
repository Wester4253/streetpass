# Backend Server Configuration
BACKEND_HOST=0.0.0.0            # Listen on all interfaces. Use 127.0.0.1 for local only
BACKEND_PORT=8010               # Port for the FastAPI backend server

# Security Settings
SECRET_KEY=changeme-supersecret # Used for JWT token signing - CHANGE THIS!
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # How long login tokens last (24 hours)

# Database Configuration
DATABASE_URL=sqlite:///streetpass.db  # SQLite database location

# File Storage
AVATAR_DIR=/opt/streetpass/backend/avatars  # Where user avatars are stored
STATIC_DIR=/opt/streetpass/backend/app/static  # Location of static files
MAX_AVATAR_SIZE=500000         # Maximum avatar file size in bytes (500KB)

# Security and CORS
ALLOWED_HOSTS=localhost,127.0.0.1,*.ts.net  # Comma-separated list of allowed hosts
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080  # Allowed frontend origins

# Frontend Configuration
FRONTEND_HOST=0.0.0.0          # Frontend server host
FRONTEND_PORT=8080             # Frontend server port
BACKEND_URL=http://localhost:8010  # URL where frontend can reach backend

# Environment
ENV=development                # development or production
DEBUG=true                     # Enable debug mode (more logging)
