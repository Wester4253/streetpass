[Unit]
Description=StreetPass Backend Service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=streetpass
Group=streetpass
WorkingDirectory=/opt/streetpass/backend
Environment="PYTHONUNBUFFERED=1"
Environment=ENV=production
ExecStart=/opt/streetpass/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5
StandardOutput=append:/var/log/streetpass/backend.log
StandardError=append:/var/log/streetpass/backend.log

[Install]
WantedBy=multi-user.target
