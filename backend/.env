# Secret key for encryption (just make it long and random)
SECRET_KEY=thisisakeyidontcareitsnotsecureijustwannauseit

# Database (SQLite is fine for <10 users)
DATABASE_URL=sqlite:///streetpass.db

# Allowed hosts (add your LAN IP or domain if needed)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.174

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origins allowed for CORS
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.0.174:8080

# Maximum avatar file size in bytes
MAX_AVATAR_SIZE=500000
